{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".vercel/output",
    "rootDir": "."
  },
  "include": ["api/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "scripts/test-pipeline.ts",
    "scripts/test-weekly.ts"
  ]
}
